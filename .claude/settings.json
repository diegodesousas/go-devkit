{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go env *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make test-all)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git stash list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(docker info *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "gofmt",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
