{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make test-all)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make shell)",
      "Bash(docker compose run --rm dev *)",
      "Bash(docker compose --progress quiet run --rm dev *)",
      "Bash(docker compose build dev)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git stash list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(docker info *)"
    ],
    "deny": [
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && docker compose --progress quiet run --rm -T -e CLAUDE_PROJECT_DIR dev sh .claude/hooks/gofmt.sh 2>/dev/null || true",
            "statusMessage": "gofmt (dev container)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
